{
    "manufacturer": "Chronos",
    "keyboard_name": "My Hackpad",
    "maintainer": "qmk",
    "processor": "RP2040",
    "bootloader": "rp2040",
    "features": {
        "bootmagic": true,
        "command": false,
        "console": false,
        "extrakey": true,
        "mousekey": true,
        "nkro": true,
        "encoder": true,
        "oled": true,
        "rgblight": true
    },
    "matrix_pins": {
        "cols": ["GP26", "GP27", "GP28"],
        "rows": ["GP3", "GP4", "GP2"]
    },
    "diode_direction": "COL2ROW",
    "encoder": {
        "rotary": [
            {"pin_a": "GP1", "pin_b": "GP0"}
        ]
    },
    "ws2812": {
        "pin": "GP29"
    },
    "rgblight": {
        "led_count": 12,
        "animations": {
            "all": true
        }
    },
    "layouts": {
        "LAYOUT": {
            "layout": [
                {"matrix": [0, 0], "x": 0, "y": 0},
                {"matrix": [0, 1], "x": 1, "y": 0},
                {"matrix": [0, 2], "x": 2, "y": 0},
                {"matrix": [1, 0], "x": 0, "y": 1},
                {"matrix": [1, 1], "x": 1, "y": 1},
                {"matrix": [1, 2], "x": 2, "y": 1},
                {"matrix": [2, 0], "x": 0, "y": 2},
                {"matrix": [2, 1], "x": 1, "y": 2},
                {"matrix": [2, 2], "x": 2, "y": 2}
            ]
        }
    }
}